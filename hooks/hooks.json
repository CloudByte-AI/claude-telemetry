{
  "description": "CloudByte Unified Memory & Sync System",
  "hooks": {
    "Setup": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/validate.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PLUGIN_ROOT}\" -m src.main session_start",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit|Read|WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:4723/guardrails/claude/pre_tool_use",
            "timeout": 10,
            "headers": {
              "X-CloudByte-Guardrails-Disabled": "$CLOUDBYTE_GUARDRAILS_DISABLED"
            },
            "allowedEnvVars": ["CLOUDBYTE_GUARDRAILS_DISABLED"],
            "statusMessage": "CloudByte: checking guardrails..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PLUGIN_ROOT}\" -m src.main user_prompt",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PLUGIN_ROOT}\" -m src.main stop",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PLUGIN_ROOT}\" -m src.main session_end",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CloudByte"
    Width="480"
    Height="440"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    WindowStyle="SingleBorderWindow"
    Background="#111111"
    FontFamily="Segoe UI"
    ShowInTaskbar="False"
    Topmost="True">

    <Window.Resources>
        <!-- Thin, dark scrollbar thumb matching the CloudByte dashboard's own
             ::-webkit-scrollbar-thumb styling (border-alt colored, subtle) -->
        <Style x:Key="ThinScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#454545"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollThumb}"/>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Margin="0,0,4,0"/>
                            <ScrollBar Grid.Column="1"
                                       Style="{StaticResource ThinScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat button template - the stock Windows Button chrome applies its
             own MouseOver highlight regardless of a plain Background setter,
             so a custom flat template is the only way to suppress the hover
             tint while keeping the hand cursor. -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="CLOUD" FontSize="15" FontWeight="Bold" Foreground="#faf9f6"/>
            <TextBlock Text="BYTE" FontSize="15" FontWeight="Bold" Foreground="#ff5600"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1a1a1a" BorderBrush="#313130" BorderThickness="1"
                CornerRadius="10" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Border Width="42" Height="42" Background="#dc2626" CornerRadius="8" VerticalAlignment="Top">
                            <TextBlock Text="!" Foreground="White" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Prompt blocked" Margin="14,6,0,0" FontSize="20" FontWeight="SemiBold"
                                   Foreground="#faf9f6" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Name="CopyButton" DockPanel.Dock="Right" Width="34" Height="34"
                            Style="{StaticResource FlatButton}" Background="#242424"
                            BorderThickness="0" Cursor="Hand" VerticalAlignment="Top"
                            ToolTip="Copy sanitized prompt">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="8" Canvas.Top="2" Width="8" Height="4"
                                           RadiusX="1" RadiusY="1" Stroke="#faf9f6" StrokeThickness="2"/>
                                <Path Stroke="#faf9f6" StrokeThickness="2" StrokeLineJoin="Round"
                                      Data="M16,4 H18 A2,2 0 0 1 20,6 V20 A2,2 0 0 1 18,22 H6 A2,2 0 0 1 4,20 V6 A2,2 0 0 1 6,4 H8"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </DockPanel>

                <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScrollViewer}"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#9c9fa5" LineHeight="20">__MESSAGE_BODY__</TextBlock>
                </ScrollViewer>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" LastChildFill="False">
            <Button Name="OkButton" Content="OK" Width="96" Height="34"
                    HorizontalAlignment="Right" DockPanel.Dock="Right"
                    Style="{StaticResource FlatButton}"
                    Background="#ff5600" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</Window>
